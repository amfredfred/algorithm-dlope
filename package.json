{
  "name": "dlope-feed-1241-regression-suite",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "npm run build && node dist/src/index.js",
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/tests/*.test.js --test-reporter=spec",
    "test:verbose": "npm run build && node --test dist/tests/*.test.js --test-reporter=spec",
    "test:tap": "npm run build && node --test dist/tests/*.test.js --test-reporter=tap"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "~5.8.3"
  }
}
