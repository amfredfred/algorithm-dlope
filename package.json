{
  "name": "dlope-feed-verified-regressions",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "npm run build && node dist/src/feed.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node scripts/run-tests.mjs",
    "test:spec": "npm run build && node --test --test-reporter=spec dist/tests/*.test.js test/*.test.mjs",
    "test:tap": "npm run build && node --test --test-reporter=tap dist/tests/*.test.js test/*.test.mjs",
    "benchmark": "npm run build && node scripts/benchmark.mjs",
    "fixture:report": "npm run build && node scripts/library-fixture-report.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "~5.8.3"
  }
}
